# Server-only origin of portfolio-api. Browser calls use the same-origin /api BFF.
API_URL=https://api.example.com

# Comma-separated public frontend hosts trusted to invoke Next.js Server Actions.
# Schemes are optional. Vercel deployment hosts are added automatically.
SERVER_ACTION_ALLOWED_ORIGINS=portfolio.example.com,www.portfolio.example.com

# Optional certificates used only by `node server.js` for local HTTPS.
LOCAL_SSL_KEY=
LOCAL_SSL_CERT=
LOCAL_SSL_CA=
